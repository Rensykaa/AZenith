# Static properties: loaded from this file by Axeron/AxManager. Runtime tweaks (refresh-rate dependent props, settings, device_config) are applied at boot by service.sh -> system/functions/xos_tweak.sh.
# debug.sf.* below live here (not in xos_tweak) because SurfaceFlinger reads most of them once at start; a setprop after boot_completed is too late.
#stagefright
debug.stagefright.rtp=false
debug.stagefright.fps=false
debug.stagefright.enableshaping=0
debug.stagefright.omx-debug=0
#debug.stagefright.omx_default_rank=0
debug.stagefright.swcodec=0
debug.stagefright.profilecodec=0
debug.stagefright.experiments=0

#tracing
debug.sys.looper_stats_enabled=false
debug.atrace.tags.enableflags=0
debug.orientation.log=false
debug.art.monitor.app=false
debug.generate-debug-info=false
debug.tflite.trace=0
debug.assert=0
debug.checkjni=0
debug.nn.vlog=0
debug.jni.logging=0
debug.sensors=0
debug.synclog=0
debug.cp2.scan_all_packages=0

#renderengine
debug.angle.validation=false
debug.graphics.gpu.profiler.perfetto=false
debug.renderengine.skia_tracing_enabled=false
debug.renderengine.skia_use_perfetto_track_events=false
debug.renderengine.skia_atrace_enabled=false

#egl
debug.egl.finish=false
debug.egl.traceGpuCompletion=false
debug.egl.callstack=false
debug.egl.trace=0

#renderscript
debug.rs.debug=0
debug.rs.profile=0

#hwui
debug.hwui.filter_test_overhead=false

#surfaceflinger (static). hint_margin_us / cached_set_max_defer_render_attmpts depend on refresh rate: applied by post-fs-data.sh.
# disable_backpressure is opt-in (touch $D/opt_sf_nobackpressure, post-fs-data.sh). enable_gl_backpressure=0 / enable_hwc_vds=0 removed: already the default.
debug.sf.multithreaded_present=1
debug.sf.use_frame_rate_priority=1
debug.sf.predict_hwc_composition_strategy=1
debug.sf.enable_adpf_cpu_hint=true
